{
  "name": "@mnemo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../../.env --watch src/index.js",
    "start": "node src/index.js",
    "migrate:create": "node-pg-migrate create --migration-file-language sql",
    "migrate:up": "node --env-file-if-exists=../../.env $(command -v node-pg-migrate) up",
    "migrate:down": "node --env-file-if-exists=../../.env $(command -v node-pg-migrate) down"
  },
  "dependencies": {
    "@mnemo/shared": "*",
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "node-pg-migrate": "^9.0.0"
  }
}
