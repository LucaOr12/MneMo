{
  "name": "mnemo",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "mnemo",
      "workspaces": [
        "apps/*",
        "packages/*"
      ]
    },
    "apps/api": {
      "name": "@mnemo/api",
      "version": "0.0.0",
      "dependencies": {
        "@mnemo/shared": "*"
      }
    },
    "apps/web": {
      "name": "@mnemo/web",
      "version": "0.0.0",
      "dependencies": {
        "@mnemo/shared": "*"
      }
    },
    "node_modules/@mnemo/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@mnemo/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "node_modules/@mnemo/web": {
      "resolved": "apps/web",
      "link": true
    },
    "packages/shared": {
      "name": "@mnemo/shared",
      "version": "0.0.0"
    }
  }
}
